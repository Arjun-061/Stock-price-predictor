# QuantumPredict configuration
# No API key is required -- market data comes from yfinance's public endpoints.
# This file just makes deployment settings and the live-feed behavior tunable
# without touching code. Copy/adjust as needed per environment.

# --- Server ---
HOST=0.0.0.0
PORT=8000
# Auto-reload on code changes. Set to false in production.
RELOAD=true

# --- Logging ---
LOG_LEVEL=INFO

# --- CORS ---
# Comma-separated list of allowed origins, or "*" to allow all (default, fine for local/dev use).
CORS_ALLOW_ORIGINS=*

# --- Live feed (WebSocket) ---
# How often (in seconds) the simulated live-stream sends a price tick.
WS_TICK_INTERVAL_SECONDS=1.5
